{
  "name": "uniswap-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "v2-sdk",
    "uniswap-2-interface"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start:3002 --workspace=uniswap-2-interface",
    "dev": "npm run build:sdk && npm run start:3002 --workspace=uniswap-2-interface",
    "build:sdk": "npm run build --workspace=@uniswap/sdk",
    "build:interface": "npm run build --workspace=uniswap-2-interface",
    "preview": "npm run build:sdk && npm run build:interface && npx --yes serve -s uniswap-2-interface/build -l 3002"
  },
  "repository": "git@github.com:w-chain/w-swap-contracts.git",
  "license": "MIT",
  "engines": {
    "node": "18.x"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
